name: build

on:
  workflow_dispatch:
  push:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
      - name: Descargar Gradle 8.10
        run: |
          curl -sSL https://services.gradle.org/distributions/gradle-8.10-bin.zip -o gradle.zip
          unzip -q gradle.zip
      - name: Compilar
        run: ./gradle-8.10/bin/gradle build --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: dragons.jar
          path: build/libs/*.jar
